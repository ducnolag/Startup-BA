# Toolify — environment template
# Copy to .env and fill in the values. NEVER commit your real .env.

# ============================================================
# Agent runner (apps/agent-runner)
# ============================================================

# Required: your Anthropic API key.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: which Claude model the agent uses.
# Defaults to claude-sonnet-4-5.
AGENT_MODEL=claude-sonnet-4-5

# Optional: agent-runner log level (debug | info | warning | error).
LOG_LEVEL=info


# ============================================================
# Next.js web (apps/web)
# ============================================================

# Public URL the browser uses to reach the agent runner.
# In Docker, this stays as localhost because the web browser runs on the host.
NEXT_PUBLIC_AGENT_URL=http://localhost:8765

# Optional: Google Gemini API key for PDF Translate + Idea-to-Tool.
# Get one free at https://aistudio.google.com/apikey
# Free tier đủ cho use case cá nhân (~15 RPM, ~1M tokens/phút).
# Khi thiếu key: 2 tool Gemini tự chạy ở demo mode (trả fallback an toàn).
GEMINI_API_KEY=AIza-your-key-here

# Optional: đổi model Gemini (mặc định gemini-2.5-flash).
# Lưu ý: gemini-2.0-flash đã bị Google shutdown ngày 01/06/2026.
# Các model ổn định hiện tại: gemini-2.5-flash, gemini-3.6-flash.
# Free tier thường giới hạn ở gemini-2.5-flash (multimodal, PDF qua Files API).
# Xem https://ai.google.dev/gemini-api/docs/models để biết model mới nhất.
# GEMINI_MODEL=gemini-2.5-flash

# Watermark remover sidecar URL — Next.js API route proxy sang đây.
# Trong Docker compose, dùng tên service nội bộ. Khi dev local (không compose),
# đổi thành http://localhost:8766.
WATERMARK_SERVICE_URL=http://watermark-remover:8766

# Public URL browser dùng để gọi sidecar (chỉ dùng nếu có endpoint client-side;
# hiện tại proxy qua /api/tools/watermark-remover nên không bắt buộc).
NEXT_PUBLIC_WATERMARK_URL=http://localhost:8766

# PDF translator sidecar URL — Next.js API route proxy sang đây để dịch PDF
# trong khi giữ layout (PyMuPDF + Gemini). Cùng convention với watermark-remover.
PDF_TRANSLATOR_SERVICE_URL=http://pdf-translator:8767

# Pin upstream watermarks-remover version (cho sidecar Dockerfile).
# Xem https://github.com/guillaumemeyer/watermarks-remover/releases để chọn tag.
WATERMARKS_REF=v0.7.0

# Supabase project (optional — only needed for auth / dashboard features).
# Get these from https://supabase.com/dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

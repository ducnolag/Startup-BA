# =====================================================================
# Toolify — root .gitignore
# Applies to the entire monorepo. Service-level ignores live alongside.
# =====================================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
**/.venv/
**/venv/
**/env/
**/.env
**/.env.local
**/.env.*.local
**/*.egg-info/
**/.eggs/
**/build/
**/dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------- Node / Next.js ----------
**/node_modules/
.next/
out/
dist/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
**/*.tsbuildinfo

# ---------- IDE / editor ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Project-specific ----------
_refs/
*.bak
*.tmp
.cache/

# ---------- Local data ----------
**/data/local/
**/*.sqlite
**/*.db

# ---------- Local backups ----------
Startup-BA-backup-*/

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Watermark remover runtime temp ----------
# Sidecar xử lý PDF / DOCX / ảnh vào temp dirs này — KHÔNG commit
# output của user (privacy) và KHÔNG commit uploaded files.
apps/watermark-remover/uploads/
apps/watermark-remover/outputs/
apps/watermark-remover/__pycache__/
apps/watermark-remover/.venv/

# ---------- Agent runner Python artifacts ----------
apps/agent-runner/__pycache__/
apps/agent-runner/.venv/
apps/agent-runner/.pytest_cache/
apps/agent-runner/.ruff_cache/
apps/agent-runner/.mypy_cache/
apps/agent-runner/**/*.egg-info/

# ---------- Next.js build artifacts (giữ .dockerignore của web đã lo, nhưng đề phòng) ----------
apps/web/.next/
apps/web/.swc/
apps/web/out/

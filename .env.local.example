
# ---- Supabase (BẮT BUỘC khi muốn dùng Google/GitHub OAuth) ---------
NEXT_PUBLIC_SUPABASE_URL='https://YOUR_PROJECT.supabase.co'
NEXT_PUBLIC_SUPABASE_ANON_KEY='YOUR_ANON_KEY'
SUPABASE_SERVICE_ROLE_KEY='YOUR_SERVICE_ROLE_KEY'

# ---- App URL (dùng cho OAuth redirect) ------------------------------
NEXT_PUBLIC_APP_URL='http://localhost:3000'

# ---- Optional: scrape API keys (Phần B — affiliate) ----------------
# SHOPEE_AFFILIATE_ID=
# SHOPEE_AFFILIATE_KEY=
# LAZADA_AFFILIATE_KEY=
# TIKI_AFFILIATE_ID=
# TIKI_AFFILIATE_KEY=
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=

# ---- Gemini AI (Phase 1: Mua thông minh tool) ----------------------
# Get free API key: https://aistudio.google.com/apikey
NEXT_PUBLIC_GEMINI_API_KEY='YOUR_GEMINI_API_KEY'
# Default: 'gemini-2.5-flash' (free, fast). Alternatives: 'gemma-3-27b-it', 'gemini-2.0-flash'
NEXT_PUBLIC_GEMINI_MODEL='gemini-2.5-flash'

